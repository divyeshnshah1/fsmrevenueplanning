If(HierarchyElementExists('Clients and Segments','Leaves',Representative_Profile__Client_Proxies_L5)=1);
StringToNumber('IMPERROR_CL_'|Representative_Profile__Client_Proxies_L5);
EndIf;
HierarchyElementInsert('Clients and Segments','Clients and Segments','',Representative_Profile__Client_Proxies_L5,'C');
