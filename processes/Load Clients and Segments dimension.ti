#region Prolog
MinorErrorLogMax = -1;
OnMinorErrorDoItemSkip = 1;
SetInputCharacterSet('TM1CS_ISO_8859_1');
vType='N';
vWeight=1.0;
If (DimensionExists('Clients and Segments') = 0);
DimensionCreate('Clients and Segments');
EndIf;
lastAttr='';
iAttr=DIMSIZ('}ElementAttributes_Clients and Segments');
i=iAttr;
While(i > 0);
attrName = DIMNM('}ElementAttributes_Clients and Segments', i);
If(SUBST(attrName,0,1)@<>'}');
lastAttr=attrName;
i=0;
Else;
i=i-1;
EndIf;
End;
ElementAttrInsert('Clients and Segments','Clients and Segments',lastAttr,'Customer Type Description','S');
lastAttr = 'Customer Type Description';

#endregion
#region Metadata
vLastMember='';
If(Representative_Profile__Client_Proxies_L5@<>'');
